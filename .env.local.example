# ============================================================
#  alphanews dashboard — μεταβλητές περιβάλλοντος (env vars)
# ------------------------------------------------------------
#  Αντίγραψε αυτό το αρχείο σε ".env.local" και συμπλήρωσε τις τιμές.
#  Αν αφήσεις κενό το GA4_PROPERTY_ID, το dashboard τρέχει σε DEMO mode
#  (ψεύτικα δεδομένα) ώστε να το δεις να δουλεύει χωρίς credentials.
# ============================================================

# 1) Το αριθμητικό Property ID του GA4 (π.χ. 123456789)
#    GA4 > Admin > Property Settings > Property ID
GA4_PROPERTY_ID=

# 2) Τα στοιχεία του Google Cloud service account.
#    Από το αρχείο JSON που κατεβάζεις, αντίγραψε:
#      - το "client_email"
#      - το "private_key" (ΟΛΟΚΛΗΡΟ, μαζί με -----BEGIN/END PRIVATE KEY-----)
#
#    ΣΗΜΑΝΤΙΚΟ για το private key: βάλ' το σε μία γραμμή μέσα σε διπλά εισαγωγικά
#    και κράτα τα \n όπως είναι (δηλ. literal backslash-n, όχι αλλαγές γραμμής).
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=""

# (Εναλλακτικά, αντί για τα δύο παραπάνω, μπορείς να βάλεις ολόκληρο
#  το JSON του service account σε μία μεταβλητή — χρήσιμο στο Vercel.)
# GA4_CREDENTIALS_JSON=


# ============================================================
#  ΗΜΕΡΗΣΙΑ ΚΑΤΑΜΕΤΡΗΣΗ ΑΡΘΡΩΝ ΑΝΑ ΣΥΝΤΑΚΤΗ (cron 09:00)
# ------------------------------------------------------------
#  Διαβάζει τα άρθρα από το WordPress του alphatv.gr και γράφει
#  την καταμέτρηση του προηγούμενου 24ώρου σε ένα Google Sheet.
# ============================================================

# 3) Το CMS. Άφησέ το κενό για το προεπιλεγμένο https://www.alphatv.gr
CMS_BASE_URL=

# 3α) ΜΟΝΟ αν το /wp-json είναι κλειστό στο κοινό:
#     WP admin > Χρήστες > Το προφίλ μου > Application Passwords
#     Βάλε το username σου και τον κωδικό που παράγεται (με τα κενά, όπως είναι).
CMS_WP_USER=
CMS_WP_APP_PASSWORD=

# 4) Το Google Sheet όπου γράφεται η αναφορά.
#    Είναι το μακρύ κομμάτι του URL:
#    https://docs.google.com/spreadsheets/d/<ΑΥΤΟ_ΕΔΩ>/edit
#    Ήδη συμπληρωμένο με το Sheet «alphanews — Καταμέτρηση άρθρων ανά συντάκτη».
#    (Δεν είναι μυστικό: από μόνο του δεν δίνει πρόσβαση σε κανέναν.)
SHEETS_SPREADSHEET_ID=10HBDZe4IOnGv4lY1HIstWIYrMgWgv5ikXayaepsZyPM

# 5) Service account με δικαίωμα εγγραφής στο Sheet.
#    - Google Cloud > APIs & Services > Enable "Google Sheets API"
#    - Credentials > Create Credentials > Service account > Keys > JSON
#    - Άνοιξε το Sheet > Share > βάλε το client_email ως "Editor"
#    Το private key σε ΜΙΑ γραμμή, σε διπλά εισαγωγικά, κρατώντας τα \n.
#    ΕΥΚΟΛΟ: στο JSON η τιμή του "private_key" είναι ΗΔΗ σε μία γραμμή με \n —
#    αντίγραψέ την αυτούσια, μαζί με τα διπλά εισαγωγικά.
GOOGLE_SHEETS_CLIENT_EMAIL=alphanews-sheets@ai-tracker-501813.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY=""

# (Εναλλακτικά ολόκληρο το JSON σε μία μεταβλητή:)
# GOOGLE_SHEETS_CREDENTIALS_JSON=

# 6) Μυστικό για το cron endpoint, ώστε να μην μπορεί να το τρέξει ο καθένας.
#    Βάλε μια τυχαία συμβολοσειρά — π.χ. openssl rand -hex 24
#    Στο Vercel το ίδιο όνομα (CRON_SECRET) στέλνεται αυτόματα από το Cron.
CRON_SECRET=
