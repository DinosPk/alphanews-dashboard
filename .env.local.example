# ============================================================
#  alphanews dashboard — μεταβλητές περιβάλλοντος (env vars)
# ------------------------------------------------------------
#  Αντίγραψε αυτό το αρχείο σε ".env.local" και συμπλήρωσε τις τιμές.
#  Αν αφήσεις κενό το GA4_PROPERTY_ID, το dashboard τρέχει σε DEMO mode
#  (ψεύτικα δεδομένα) ώστε να το δεις να δουλεύει χωρίς credentials.
# ============================================================

# 1) Το αριθμητικό Property ID του GA4 (π.χ. 123456789)
#    GA4 > Admin > Property Settings > Property ID
GA4_PROPERTY_ID=

# 2) Τα στοιχεία του Google Cloud service account.
#    Από το αρχείο JSON που κατεβάζεις, αντίγραψε:
#      - το "client_email"
#      - το "private_key" (ΟΛΟΚΛΗΡΟ, μαζί με -----BEGIN/END PRIVATE KEY-----)
#
#    ΣΗΜΑΝΤΙΚΟ για το private key: βάλ' το σε μία γραμμή μέσα σε διπλά εισαγωγικά
#    και κράτα τα \n όπως είναι (δηλ. literal backslash-n, όχι αλλαγές γραμμής).
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=""

# (Εναλλακτικά, αντί για τα δύο παραπάνω, μπορείς να βάλεις ολόκληρο
#  το JSON του service account σε μία μεταβλητή — χρήσιμο στο Vercel.)
# GA4_CREDENTIALS_JSON=
